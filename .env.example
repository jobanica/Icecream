# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used to create/reset partner PIN logins. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Hidden email domain behind store-code + PIN logins (ss-001@<domain>). Must match supabase/seed.sql.
PARTNER_EMAIL_DOMAIN=partners.example.com
